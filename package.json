{
  "name": "sonderr-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export -p ios -e production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "eas build --platform all --profile preview",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:local:android": "npx expo prebuild --clean && cd android && ./gradlew assembleRelease",
    "build:local:ios": "npx expo run:ios --configuration Release",
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "expo-secure-store": "~14.0.0",
    "expo-file-system": "~17.0.0",
    "expo-sharing": "~12.0.0",
    "expo-document-picker": "~13.0.0",
    "expo-web-browser": "~14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "ai": "^4.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "react-markdown": "^9.0.0",
    "react-native-pdf": "^6.7.0",
    "react-native-blob-util": "^0.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "@types/react-native": "~0.76.0",
    "typescript": "~5.3.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "expo": {
    "owner": "DXN1-termux",
    "slug": "sonderr-mobile",
  "version": "0.0.01",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonderr.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.sonderr.mobile",
      "permissions": ["INTERNET"]
    },
    "scheme": "sonderr-mobile",
    "plugins": [
      "expo-router",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Development"
        }
      ]
    ]
  },
  "eas": {
    "build": {
      "preview": {
        "distribution": "internal",
        "ios": {
          "simulator": true
        }
      },
      "production": {
        "distribution": "store",
        "ios": {
          "buildConfiguration": "Release"
        },
        "android": {
          "buildType": "app-bundle"
        }
      }
    }
  }
}
